# Copy this file to .env and adjust as needed.
# The Streamlit app (app/app.py) reads API_URL to know where the FastAPI
# backend is running. Do not include a trailing slash or the /predict path.

# Local development (FastAPI running directly on the host):
API_URL=http://127.0.0.1:8000

# docker-compose (service name "api" on the compose network):
# API_URL=http://api:8000

# Path to the fine-tuned model directory, read by api/main.py.
MODEL_PATH=distilbert-imdb-model

# Optional: log level for the FastAPI service (DEBUG, INFO, WARNING, ...).
LOG_LEVEL=INFO

# Required only to run the LLM zero/few-shot comparison in src/llm_compare.py.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
